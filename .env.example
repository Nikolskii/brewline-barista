# Скопировать в .env. Файл .env в репозиторий не коммитится.

# Базовый адрес backend API. Обязателен: Vite-proxy не используется, фронт ходит
# на API кросс-origin — и в деве, и в проде (ADR 0004). Без переменной приложение
# намеренно падает на старте, а не молча запрашивает само себя.
#
# Этот origin должен быть в списке CORS_ORIGINS на стороне backend.
VITE_API_URL=http://localhost:3000
